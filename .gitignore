# Python bytecode
__pycache__/
*.pyc

# Node dependencies. These are NOT installed per skill: each skill's
# node_modules is a symlink to the shared root ~/.agents/node_modules.
# "node_modules" (no trailing slash) also matches the symlink itself.
node_modules
node_modules/

# Browser profiles used to live in the skill dir; they now live outside the
# synced folder in ~/.agents/browser-profiles/ (kept here for safety).
**/browser-profile/

# ---------------------------------------------------------------------------
# Runtime records. These must NOT live in the repo: they are daily-growing
# output that belongs in the data workspace ~/email-assistant (see README.md).
# The skills resolve their data dir from an env var (X_DIGEST_DATA_DIR,
# NATURE_DIGEST_DATA_DIR, MAIL_ARCHIVE_ROOT, EMAIL_ASSISTANT_MEMORY), so these
# paths should never reappear — the rules below are a guard against regression.
# ---------------------------------------------------------------------------

# x-digest daily captures + generated digests + dedup store
research/x-digest/data/

# nature-digest candidates + digests + dedup store
research/nature-digest/data/

# email-assistant long-term memory (also holds dream.py, which lives with its
# data by design)
research/email-assistant/memory/

# email archive (was ~/Nutstore Files/pi-mail-archive)
**/pi-mail-archive/

# macOS / tooling noise
.DS_Store
.playwright-cli/
